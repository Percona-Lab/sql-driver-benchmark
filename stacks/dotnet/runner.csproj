<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>runner</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- defaults otherwise: tiered JIT with dynamic PGO, workstation GC (concurrent) -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
    <PackageReference Include="MySqlConnector.Authentication.Ed25519" Version="*" />
    <PackageReference Include="MySql.Data" Version="26.10.0" />
  </ItemGroup>
</Project>
