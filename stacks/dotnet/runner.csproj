<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>runner</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- defaults otherwise: tiered JIT with dynamic PGO, workstation GC (concurrent) -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
    <PackageReference Include="MySqlConnector.Authentication.Ed25519" Version="3.0.0" />
    <PackageReference Include="MySql.Data" Version="26.10.0" />
    <!-- Phase 3 frameworks. Pomelo (MySqlConnector-based) supports EF Core 9 at most. -->
    <PackageReference Include="Dapper" Version="2.1.100" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.23" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
  </ItemGroup>
</Project>
